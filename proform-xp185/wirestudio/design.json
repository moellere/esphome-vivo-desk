{
  "schema_version": "0.1",
  "id": "desk-bike",
  "name": "Desk Bike",
  "description": "ProForm XP 185 U under-desk bike controller: brake motor H-bridge, feedback pot, crank reed switch, OLED + EC11 module. See ../README.md; the control loop lives in ../desk-bike.yaml.",
  "board": {
    "library_id": "esp32-devkitc-v4",
    "mcu": "esp32",
    "framework": "esp-idf"
  },
  "power": {
    "supply": "usb-5v",
    "rail_voltage_v": 5.0,
    "regulator": "onboard-ams1117",
    "budget_ma": 2000
  },
  "requirements": [],
  "components": [
    {
      "id": "oled",
      "library_id": "ssd1306",
      "label": "OLED 1.3in SH1116",
      "params": {
        "model": "SH1106 128x64",
        "address": "0x3C"
      }
    },
    {
      "id": "dial",
      "library_id": "rotary_encoder",
      "label": "Resistance dial (EC11)",
      "params": {
        "resolution": "1"
      }
    },
    {
      "id": "btn_push",
      "library_id": "gpio_input",
      "label": "Encoder push (PSH)",
      "params": {}
    },
    {
      "id": "btn_back",
      "library_id": "gpio_input",
      "label": "Back (BAK/KEY0)",
      "params": {}
    },
    {
      "id": "btn_confirm",
      "library_id": "gpio_input",
      "label": "Confirm (CON/KEY1)",
      "params": {}
    },
    {
      "id": "brake_pot",
      "library_id": "adc",
      "label": "Brake pot wiper (harness 4)",
      "params": {
        "attenuation": "12db"
      }
    },
    {
      "id": "crank_reed",
      "library_id": "pulse_counter",
      "label": "Crank reed switch (harness 7)",
      "params": {}
    },
    {
      "id": "bridge",
      "library_id": "hbridge_mosfet",
      "label": "Brake motor bridge (harness 1/2)",
      "params": {}
    }
  ],
  "buses": [
    {
      "id": "i2c0",
      "type": "i2c",
      "frequency_hz": 400000,
      "sda": "GPIO21",
      "scl": "GPIO22"
    }
  ],
  "connections": [
    {
      "component_id": "oled",
      "pin_role": "VCC",
      "target": {
        "kind": "rail",
        "rail": "3V3"
      }
    },
    {
      "component_id": "oled",
      "pin_role": "GND",
      "target": {
        "kind": "rail",
        "rail": "GND"
      }
    },
    {
      "component_id": "oled",
      "pin_role": "SDA",
      "target": {
        "kind": "bus",
        "bus_id": "i2c0"
      }
    },
    {
      "component_id": "oled",
      "pin_role": "SCL",
      "target": {
        "kind": "bus",
        "bus_id": "i2c0"
      }
    },
    {
      "component_id": "dial",
      "pin_role": "A",
      "target": {
        "kind": "gpio",
        "pin": "GPIO16"
      }
    },
    {
      "component_id": "dial",
      "pin_role": "B",
      "target": {
        "kind": "gpio",
        "pin": "GPIO17"
      }
    },
    {
      "component_id": "btn_push",
      "pin_role": "IN",
      "target": {
        "kind": "gpio",
        "pin": "GPIO25"
      }
    },
    {
      "component_id": "btn_back",
      "pin_role": "IN",
      "target": {
        "kind": "gpio",
        "pin": "GPIO26"
      }
    },
    {
      "component_id": "btn_confirm",
      "pin_role": "IN",
      "target": {
        "kind": "gpio",
        "pin": "GPIO33"
      }
    },
    {
      "component_id": "brake_pot",
      "pin_role": "IN",
      "target": {
        "kind": "gpio",
        "pin": "GPIO34"
      }
    },
    {
      "component_id": "crank_reed",
      "pin_role": "PULSE",
      "target": {
        "kind": "gpio",
        "pin": "GPIO27"
      }
    },
    {
      "component_id": "bridge",
      "pin_role": "IN1",
      "target": {
        "kind": "gpio",
        "pin": "GPIO18"
      }
    },
    {
      "component_id": "bridge",
      "pin_role": "IN2",
      "target": {
        "kind": "gpio",
        "pin": "GPIO19"
      }
    },
    {
      "component_id": "bridge",
      "pin_role": "VM",
      "target": {
        "kind": "rail",
        "rail": "5V"
      }
    },
    {
      "component_id": "bridge",
      "pin_role": "GND",
      "target": {
        "kind": "rail",
        "rail": "GND"
      }
    }
  ],
  "passives": [
    {
      "id": "c_oled",
      "kind": "capacitor",
      "value": "100nF",
      "between": [
        "oled.VCC",
        "GND"
      ],
      "purpose": "decoupling oled"
    }
  ],
  "warnings": [],
  "esphome_extras": {
    "logger": {}
  },
  "fleet": {
    "device_name": "desk-bike",
    "tags": [
      "bike"
    ],
    "secrets_ref": {
      "wifi_ssid": "!secret wifi_ssid",
      "wifi_password": "!secret wifi_password",
      "api_key": "!secret api_key"
    }
  }
}
